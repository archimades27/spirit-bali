# Public Supabase client configuration (safe for GitHub Pages static bundle)
# NEVER put service_role or database secrets here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: override base path for custom domain (default: /spirit-bali/)
# VITE_BASE_PATH=/
